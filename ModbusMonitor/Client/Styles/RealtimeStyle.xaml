<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 实时监控页：测点卡片 + 曲线卡片 =====
         数值是卡片的主角（26px），名称与报警徽标退到第一行 -->

    <!-- 卡片容器：选中时浅蓝底 + 左侧主色条 -->
    <Style x:Key="PointCardStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E4E6EB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Margin" Value="5"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Background" Value="#F3F8FF"/>
                <Setter Property="BorderBrush" Value="#D6E4FF"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 选中态左侧 3px 主色条（默认占位不显示，避免选中时内容位移） -->
    <Style x:Key="PointCardAccentStyle" TargetType="Border">
        <Setter Property="Background" Value="#1E88E5"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Visibility" Value="Hidden"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PointCardNameStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#6B7280"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- 状态徽标：仅报警时上底色 -->
    <Style x:Key="PointCardBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="7,1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding AlarmStatus}" Value="High">
                <Setter Property="Background" Value="#FDECEC"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding AlarmStatus}" Value="Low">
                <Setter Property="Background" Value="#FFF4E5"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PointCardBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#9AA0A6"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding AlarmStatus}" Value="High">
                <Setter Property="Foreground" Value="#F44336"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding AlarmStatus}" Value="Low">
                <Setter Property="Foreground" Value="#FF9800"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PointCardValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>

    <Style x:Key="PointCardUnitStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#9AA0A6"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="4,0,0,4"/>
    </Style>

    <!-- 卡片项容器：去掉默认选中高亮，只保留内容与手型光标 -->
    <Style x:Key="PointCardItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 曲线卡片 -->
    <Style x:Key="ChartCardStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E4E6EB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16,12,16,8"/>
    </Style>

    <Style x:Key="ChartTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="ChartMetaStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#9AA0A6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="12,0,0,0"/>
    </Style>

    <!-- 页面标题与测点搜索框 -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PointSearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Width" Value="150"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
