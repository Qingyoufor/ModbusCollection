<UserControl x:Class="Client.Views.RealtimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:Client.Models"
             xmlns:prism="http://prismlibrary.com/" 
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             Background="White"
             d:DesignHeight="600" d:DesignWidth="900">
    <!--
    binding 看源和路径
    HierarchicalDataTemplate 有子节点 ItemSource DataTemplate 没有子节点
    DataType TypeA 如果渲染对象是 TypeA，按照定义的模板进行渲染
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <!--左侧设备树-->
        <DockPanel Grid.Column="0">
            <TextBlock Text="设备（按串口分组）"
                       DockPanel.Dock="Top"
                       FontSize="15"
                       FontWeight="Bold"
                       Margin="10,10"/>

            <TreeView ItemsSource="{Binding DeviceGroupNodes}" Margin="5" BorderThickness="0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectedItemChanged">
                        <i:InvokeCommandAction Command="{Binding SelectedItemChangedCommand}"
                                               CommandParameter="{Binding SelectedItem,RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                    </i:EventTrigger> 
                </i:Interaction.Triggers>
                
                <TreeView.Resources>
                    <!--串口分组节点模板，有子节点-->
                    <HierarchicalDataTemplate DataType="{x:Type local:DeviceGroupNode}"
                                              ItemsSource="{Binding Devices}">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    </HierarchicalDataTemplate>

                    <!--设备节点模板 没有子节点-->
                     <DataTemplate DataType="{x:Type local:DeviceTreeNode}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel> 
                     </DataTemplate>
                </TreeView.Resources>
            </TreeView>
        </DockPanel>

        <!-- 右侧：实时数据 + 趋势曲线 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 未选择设备时显示占位 -->
            <TextBlock Grid.Row="0" Grid.RowSpan="2"
                       Text="请在左侧选择一个设备查看实时数据"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Foreground="#999"
                       Visibility="{Binding IsDeviceNotSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- 设备标题 + 测点搜索/筛选 -->
            <Grid Grid.Row="0" Margin="10,10,10,0"
                  Visibility="{Binding IsDeviceSelected,Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding SelectedDeviceName}"
                           Style="{StaticResource PageTitleStyle}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="搜索测点"
                               VerticalAlignment="Center"
                               Foreground="#666"
                               Margin="0,0,8,0"/>

                    <TextBox Style="{StaticResource PointSearchBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Content="仅看报警"
                              IsChecked="{Binding OnlyAlarms}"
                              VerticalAlignment="Center"
                              Margin="14,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 数值区（上，限高可滚动） + 趋势区（下，常驻） -->
            <Grid Grid.Row="1" Margin="10,8,10,10"
                  Visibility="{Binding IsDeviceSelected,Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="130"/>
                    <RowDefinition Height="3*" MinHeight="240"/>
                </Grid.RowDefinitions>

                <!-- 卡片模式：≤12 个测点 -->
                <ListBox Grid.Row="0"
                         ItemsSource="{Binding ViewPoints}"
                         SelectedItem="{Binding SelectedPoint}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding IsCardMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource PointCardItemStyle}"/>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PointCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 选中态左侧主色条：隐藏时仍占位，内容不位移 -->
                                    <Border Grid.Column="0" Style="{StaticResource PointCardAccentStyle}" Margin="0,0,9,0"/>

                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource PointCardNameStyle}"/>
                                            <Border Style="{StaticResource PointCardBadgeStyle}" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource PointCardBadgeTextStyle}"/>
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding DisplayValue}" Style="{StaticResource PointCardValueStyle}">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{Binding ValueColor}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>

                                            <TextBlock Text="{Binding Unit}" Style="{StaticResource PointCardUnitStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 表格模式：>12 个测点 -->
                <DataGrid Grid.Row="0"
                          Style="{StaticResource PointTableDataGridStyle}"
                          ItemsSource="{Binding ViewPoints}"
                          SelectedItem="{Binding SelectedPoint}"
                          CanUserSortColumns="False"
                          Visibility="{Binding IsTableMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}"/>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="测点名称" Binding="{Binding Name}" Width="*"
                                            CellStyle="{StaticResource PointNameCellStyle}"/>

                        <DataGridTemplateColumn Header="当前值" Width="150"
                                                CellTemplate="{StaticResource PointValueCellTemplate}"/>

                        <DataGridTemplateColumn Header="状态" Width="110"
                                                CellTemplate="{StaticResource PointStatusCellTemplate}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 趋势区：测点选择并入标题行，整块高度留给曲线 -->
                <Border Grid.Row="1" MinHeight="220" Margin="0,12,0,0"
                        Style="{StaticResource ChartCardStyle}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding TrendTitle}"
                                       Style="{StaticResource ChartTitleStyle}"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!-- 测点切换：可搜索下拉，与卡片/表格共用选中项 -->
                                <ComboBox Width="180" Height="28"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding DataPoints}"
                                          SelectedItem="{Binding SelectedPoint}"
                                          DisplayMemberPath="Name"
                                          TextSearch.TextPath="Name"
                                          IsTextSearchEnabled="True"/>
                                <TextBlock Text="最近 60 秒 · 每秒刷新" Style="{StaticResource ChartMetaStyle}"/>
                            </StackPanel>
                        </Grid>

                        <lvc:CartesianChart Series="{Binding TrendSeries}"
                                            XAxes="{Binding TrendXAxes}"
                                            YAxes="{Binding TrendYAxes}"
                                            AnimationsSpeed="0:0:0.3"
                                            TooltipPosition="Top"
                                            TooltipTextSize="12"
                                            TooltipTextPaint="{Binding TooltipTextPaint}"
                                            TooltipBackgroundPaint="{Binding TooltipBackgroundPaint}"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
