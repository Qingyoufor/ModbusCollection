<UserControl x:Class="Client.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:Client.Models"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="White"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：设备树 + 测点列表（2:3 比例，各自滚动） -->
        <Grid Grid.Column="0" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="设备导航"
                       FontSize="15" FontWeight="Bold" Margin="5"/>

            <TreeView Grid.Row="1" Margin="0,0,0,4"
                      ItemsSource="{Binding DeviceGroupNodes}"
                      BorderThickness="0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectedItemChanged">
                        <i:InvokeCommandAction Command="{Binding SelectedItemChangedCommand}"
                                               CommandParameter="{Binding SelectedItem,RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>

                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type local:DeviceGroupNode}"
                                              ItemsSource="{Binding Devices}">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    </HierarchicalDataTemplate>

                    <DataTemplate DataType="{x:Type local:DeviceTreeNode}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>

            <TextBlock Grid.Row="2" Text="测点列表" FontSize="14" FontWeight="Bold" Margin="5,10,5,5"/>

            <TextBox Grid.Row="3" Height="28" Margin="5,0,5,5"
                     VerticalContentAlignment="Center"
                     Text="{Binding PointSearchText, UpdateSourceTrigger=PropertyChanged}"/>

            <ListBox Grid.Row="4"
                     ItemsSource="{Binding PointsView}"
                     SelectedItem="{Binding SelectedPoint}"
                     DisplayMemberPath="Name"
                     BorderThickness="0"/>
        </Grid>

        <!-- 右侧：查询条件 + 统计 + 趋势图 -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <!-- 查询条件：窄窗口下自动换行，避免右侧被截断 -->
            <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                <TextBlock Text="开始：" VerticalAlignment="Center" Margin="0,0,0,6"/>
                <hc:DateTimePicker SelectedDateTime="{Binding StartTime}"
                                   Width="170" Margin="0,0,10,6"/>

                <TextBlock Text="结束：" VerticalAlignment="Center" Margin="0,0,0,6"/>
                <hc:DateTimePicker SelectedDateTime="{Binding EndTime}"
                                   Width="170" Margin="0,0,10,6"/>

                <Button Content="查询" Command="{Binding QueryCommand}"
                        Width="70" Margin="0,0,10,6"/>
                <Button Content="导出 CSV" Command="{Binding ExportCommand}"
                        Width="90" Margin="0,0,0,6"/>
            </WrapPanel>

            <!-- 快捷时间范围 + 统计面板 -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                <Button Content="近 1 小时" Command="{Binding LastHourCommand}" Width="90" Margin="0,0,8,6"/>
                <Button Content="今天" Command="{Binding TodayCommand}" Width="70" Margin="0,0,8,6"/>
                <Button Content="近 7 天" Command="{Binding Last7DaysCommand}" Width="80" Margin="0,0,8,6"/>

                <TextBlock Text="{Binding MaxText}" FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,18,6"/>
                <TextBlock Text="{Binding MinText}" FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,18,6"/>
                <TextBlock Text="{Binding AverageText}" FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,18,6"/>
                <TextBlock Text="{Binding CountText}" FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,0,6"/>
            </WrapPanel>

            <!-- 趋势图卡片：标题行 + 曲线 + 空状态提示 -->
            <Border Grid.Row="2" MinHeight="220"
                    Background="White"
                    BorderBrush="#ECECEC" BorderThickness="1"
                    CornerRadius="8" Padding="16,12,16,4">
                <Grid>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding SelectedPoint.Name}"
                                       FontSize="14" FontWeight="SemiBold" Foreground="#333333"/>
                            <TextBlock Text="{Binding SelectedPoint.Unit}"
                                       FontSize="11" Foreground="#999999"
                                       VerticalAlignment="Bottom" Margin="6,0,0,2"/>
                        </StackPanel>

                        <lvc:CartesianChart Series="{Binding TrendSeries}"
                                            XAxes="{Binding TrendXAxes}"
                                            YAxes="{Binding TrendYAxes}"/>
                    </DockPanel>

                    <TextBlock Text="{Binding ChartHint}"
                               FontSize="14" Foreground="#999999"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsChartEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- 加载提示 -->
            <TextBlock Grid.Row="3" Text="加载中..."
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </Grid>
    </Grid>
</UserControl>
