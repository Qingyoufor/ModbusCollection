<UserControl x:Class="Client.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Client.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- Tab1: Modbus 配置（含数据保留） -->
            <TabItem Header="Modbus 配置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16">

                        <!-- 端口映射 -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="端口映射（从站 → 主站）" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                <ItemsControl ItemsSource="{Binding PortMappings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBox Width="100" Style="{StaticResource SettingsTextBoxStyle}"
                                                         Text="{Binding SlaveCom, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="→" Margin="10,0" VerticalAlignment="Center" Foreground="#9AA0A6"/>
                                                <TextBox Width="100" Style="{StaticResource SettingsTextBoxStyle}"
                                                         Text="{Binding MasterCom, UpdateSourceTrigger=PropertyChanged}"/>
                                                <Button Content="删除" Height="28" MinWidth="0" Padding="12,0" Margin="14,0,0,0"
                                                        Style="{StaticResource SettingsSecondaryButtonStyle}"
                                                        Command="{Binding DataContext.RemoveMappingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="+ 添加映射" Height="28" HorizontalAlignment="Left" Margin="0,6,0,0"
                                        Style="{StaticResource SettingsSecondaryButtonStyle}"
                                        Command="{Binding AddMappingCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- 串口参数：左标签、右输入，两列 -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="串口参数" Style="{StaticResource SettingsSectionTitleStyle}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="波特率" Width="160" Style="{StaticResource SettingsLabelStyle}"/>
                                    <TextBox Width="110" Margin="0,0,24,0" Style="{StaticResource SettingsTextBoxStyle}"
                                             Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="数据位" Width="160" Style="{StaticResource SettingsLabelStyle}"/>
                                    <TextBox Width="110" Style="{StaticResource SettingsTextBoxStyle}"
                                             Text="{Binding DataBits, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="停止位 (One/Two)" Width="160" Style="{StaticResource SettingsLabelStyle}"/>
                                    <TextBox Width="110" Margin="0,0,24,0" Style="{StaticResource SettingsTextBoxStyle}"
                                             Text="{Binding StopBits, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="校验位 (None/Odd/Even)" Width="160" Style="{StaticResource SettingsLabelStyle}"/>
                                    <TextBox Width="110" Style="{StaticResource SettingsTextBoxStyle}"
                                             Text="{Binding Parity, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="读超时" Width="160" Style="{StaticResource SettingsLabelStyle}"/>
                                    <TextBox Width="110" Margin="0,0,24,0" Style="{StaticResource SettingsTextBoxStyle}"
                                             Text="{Binding ReadTimeout, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="写超时" Width="160" Style="{StaticResource SettingsLabelStyle}"/>
                                    <TextBox Width="110" Style="{StaticResource SettingsTextBoxStyle}"
                                             Text="{Binding WriteTimeout, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <TextBlock Text="超时单位为毫秒（ms）。" Style="{StaticResource SettingsHintStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- 采集周期 -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="采集周期" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="轮询间隔" Width="160" Style="{StaticResource SettingsLabelStyle}"/>
                                    <TextBox Width="110" Style="{StaticResource SettingsTextBoxStyle}"
                                             Text="{Binding PollIntervalMs, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="8,0,0,0"
                                               FontSize="13" Foreground="#6B7280"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 数据保留 -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="数据保留" Style="{StaticResource SettingsSectionTitleStyle}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="历史数据保留天数" Width="160" Style="{StaticResource SettingsLabelStyle}"/>
                                    <TextBox Width="110" Style="{StaticResource SettingsTextBoxStyle}"
                                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                                             DataObject.Pasting="NumericTextBox_Pasting"
                                             Text="{Binding DeviceDataDays, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="天" VerticalAlignment="Center" Margin="8,0,0,0"
                                               FontSize="13" Foreground="#6B7280"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="报警记录保留天数" Width="160" Style="{StaticResource SettingsLabelStyle}"/>
                                    <TextBox Width="110" Style="{StaticResource SettingsTextBoxStyle}"
                                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                                             DataObject.Pasting="NumericTextBox_Pasting"
                                             Text="{Binding AlarmDays, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="天" VerticalAlignment="Center" Margin="8,0,0,0"
                                               FontSize="13" Foreground="#6B7280"/>
                                </StackPanel>

                                <TextBlock Text="归档服务每 5 秒检查一次，超过保留天数的数据会被自动清理。"
                                           Style="{StaticResource SettingsHintStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab2: 关于 -->
            <TabItem Header="关于">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="ModbusMonitor" FontSize="20" FontWeight="Bold" Foreground="#1F2329"/>
                                <TextBlock Text="{Binding SystemInfo.Version, StringFormat=版本 {0}}"
                                           FontSize="12" Foreground="#9AA0A6" Margin="0,4,0,18"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="服务启动" Width="100" HorizontalAlignment="Left"
                                               Style="{StaticResource SettingsLabelStyle}"/>
                                    <TextBlock Text="{Binding SystemInfo.ServerStartedAtLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                               FontSize="13" Foreground="#1F2329" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="已运行" Width="100" HorizontalAlignment="Left"
                                               Style="{StaticResource SettingsLabelStyle}"/>
                                    <TextBlock Text="{Binding SystemInfo.UpTime}"
                                               FontSize="13" Foreground="#1F2329" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="在线设备" Width="100" HorizontalAlignment="Left"
                                               Style="{StaticResource SettingsLabelStyle}"/>
                                    <TextBlock Text="{Binding SystemInfo.OnlineDeviceCount}"
                                               FontSize="13" Foreground="#1F2329" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="缓存测点" Width="100" HorizontalAlignment="Left"
                                               Style="{StaticResource SettingsLabelStyle}"/>
                                    <TextBlock Text="{Binding SystemInfo.CachedPointCount}"
                                               FontSize="13" Foreground="#1F2329" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Modbus 状态" Width="100" HorizontalAlignment="Left"
                                               Style="{StaticResource SettingsLabelStyle}"/>
                                    <TextBlock Text="{Binding SystemInfo.ModbusRunning}"
                                               FontSize="13" Foreground="#1F2329" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="最近轮询" Width="100" HorizontalAlignment="Left"
                                               Style="{StaticResource SettingsLabelStyle}"/>
                                    <TextBlock Text="{Binding SystemInfo.LastPollTimeLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                               FontSize="13" Foreground="#1F2329" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Content="刷新" Height="28" HorizontalAlignment="Left"
                                        Style="{StaticResource SettingsSecondaryButtonStyle}"
                                        Command="{Binding LoadInfoCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 底部操作栏：左侧结果提示，右侧按钮 -->
        <DockPanel Grid.Row="1" Margin="4,12,4,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="重载 Modbus" Margin="0,0,8,0"
                        Style="{StaticResource SettingsSecondaryButtonStyle}"
                        Command="{Binding ReloadModbusCommand}"/>
                <Button Content="保存配置"
                        Style="{StaticResource SettingsPrimaryButtonStyle}"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SettingsStatusTextStyle}"/>
        </DockPanel>
    </Grid>
</UserControl>
